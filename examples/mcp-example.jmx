<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="MCP Example Test Plan" enabled="true">
      <stringProp name="TestPlan.comments">Example plan for the JMeter MCP plugin.

Prerequisites:
  1. Build and install the plugin JAR into JMETER_HOME/lib/ext/
  2. Node.js and npx on PATH (for the default STDIO server below)
  3. Restart JMeter after installing the plugin

This plan uses the official @modelcontextprotocol/server-everything demo
server over STDIO. To use Streamable HTTP instead, change the MCP Client
Config transport to STREAMABLE_HTTP, set Server URL (e.g.
http://localhost:8080), and point Command/Args at your running server.

Open View Results Tree after a run: session metadata appears under Response
headers (X-MCP-Operation, X-MCP-Session); operation output is the pretty-
printed JSON response body.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <io.github.jmeter.mcp.config.McpClientConfig guiclass="io.github.jmeter.mcp.config.gui.McpClientConfigGui" testclass="io.github.jmeter.mcp.config.McpClientConfig" testname="MCP Client Config">
        <stringProp name="McpClientConfig.name">mcpClient</stringProp>
        <stringProp name="McpClientConfig.transport">STDIO</stringProp>
        <stringProp name="McpClientConfig.serverUrl"></stringProp>
        <stringProp name="McpClientConfig.endpoint"></stringProp>
        <stringProp name="McpClientConfig.stdioCommand">npx</stringProp>
        <stringProp name="McpClientConfig.stdioArgs">-y @modelcontextprotocol/server-everything</stringProp>
        <stringProp name="McpClientConfig.stdioEnv"></stringProp>
        <stringProp name="McpClientConfig.clientName">jmeter-mcp-plugin</stringProp>
        <stringProp name="McpClientConfig.clientVersion">0.1.0</stringProp>
        <longProp name="McpClientConfig.requestTimeoutMs">30000</longProp>
        <longProp name="McpClientConfig.initTimeoutMs">30000</longProp>
      </io.github.jmeter.mcp.config.McpClientConfig>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="MCP Thread Group" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <io.github.jmeter.mcp.sampler.McpSampler guiclass="io.github.jmeter.mcp.sampler.gui.McpSamplerGui" testclass="io.github.jmeter.mcp.sampler.McpSampler" testname="MCP Ping">
          <stringProp name="McpSampler.configName">mcpClient</stringProp>
          <stringProp name="McpSampler.operation">PING</stringProp>
          <stringProp name="McpSampler.toolName"></stringProp>
          <stringProp name="McpSampler.argumentsJson">{}</stringProp>
          <stringProp name="McpSampler.resourceUri"></stringProp>
          <stringProp name="McpSampler.promptName"></stringProp>
        </io.github.jmeter.mcp.sampler.McpSampler>
        <hashTree/>
        <io.github.jmeter.mcp.sampler.McpSampler guiclass="io.github.jmeter.mcp.sampler.gui.McpSamplerGui" testclass="io.github.jmeter.mcp.sampler.McpSampler" testname="MCP List Tools">
          <stringProp name="McpSampler.configName">mcpClient</stringProp>
          <stringProp name="McpSampler.operation">LIST_TOOLS</stringProp>
          <stringProp name="McpSampler.toolName"></stringProp>
          <stringProp name="McpSampler.argumentsJson">{}</stringProp>
          <stringProp name="McpSampler.resourceUri"></stringProp>
          <stringProp name="McpSampler.promptName"></stringProp>
        </io.github.jmeter.mcp.sampler.McpSampler>
        <hashTree/>
        <io.github.jmeter.mcp.sampler.McpSampler guiclass="io.github.jmeter.mcp.sampler.gui.McpSamplerGui" testclass="io.github.jmeter.mcp.sampler.McpSampler" testname="MCP Call Tool (echo)">
          <stringProp name="McpSampler.configName">mcpClient</stringProp>
          <stringProp name="McpSampler.operation">CALL_TOOL</stringProp>
          <stringProp name="McpSampler.toolName">echo</stringProp>
          <stringProp name="McpSampler.argumentsJson">{&quot;message&quot;: &quot;hello from JMeter&quot;}</stringProp>
          <stringProp name="McpSampler.resourceUri"></stringProp>
          <stringProp name="McpSampler.promptName"></stringProp>
        </io.github.jmeter.mcp.sampler.McpSampler>
        <hashTree/>
        <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time>
              <latency>true</latency>
              <timestamp>true</timestamp>
              <success>true</success>
              <label>true</label>
              <code>true</code>
              <message>true</message>
              <threadName>true</threadName>
              <dataType>true</dataType>
              <encoding>false</encoding>
              <assertions>true</assertions>
              <subresults>true</subresults>
              <responseData>true</responseData>
              <samplerData>true</samplerData>
              <xml>false</xml>
              <fieldNames>true</fieldNames>
              <responseHeaders>true</responseHeaders>
              <requestHeaders>false</requestHeaders>
              <responseDataOnError>false</responseDataOnError>
              <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
              <assertionsResultsToSave>0</assertionsResultsToSave>
              <bytes>true</bytes>
              <sentBytes>true</sentBytes>
              <url>true</url>
              <threadCounts>true</threadCounts>
              <idleTime>true</idleTime>
              <connectTime>true</connectTime>
            </value>
          </objProp>
          <stringProp name="filename"></stringProp>
        </ResultCollector>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
