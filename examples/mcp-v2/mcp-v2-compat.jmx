<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="MCP v2 probe">
      <stringProp name="TestPlan.comments">Java SDK 1.1.1 client vs TypeScript MCP SDK v2.

Once: cd examples/mcp-v2 &amp;&amp; npm install
Open this .jmx from examples/mcp-v2/. One Ping per transport. Inspect View Results Tree.

  HTTP dual   http://127.0.0.1:18080/mcp
  HTTP strict http://127.0.0.1:18081/mcp
  STDIO dual  node stdio.mjs
  STDIO strict node stdio.mjs --strict
  SSE /sse and SSE /mcp against the HTTP dual listener (8s timeout)</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
    </TestPlan>
    <hashTree>
      <com.blazemeter.jmeter.mcp.server.McpServerProcess guiclass="com.blazemeter.jmeter.mcp.server.gui.McpServerProcessGui" testclass="com.blazemeter.jmeter.mcp.server.McpServerProcess" testname="MCP Server (HTTP v2 probe)">
        <stringProp name="McpServerProcess.command">node</stringProp>
        <stringProp name="McpServerProcess.args">&quot;${__groovy(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir())}/server.mjs&quot;</stringProp>
        <stringProp name="McpServerProcess.env">DUAL_PORT=18080
STRICT_PORT=18081</stringProp>
        <stringProp name="McpServerProcess.readyHost">127.0.0.1</stringProp>
        <longProp name="McpServerProcess.readyPort">18080</longProp>
        <longProp name="McpServerProcess.startupWaitMs">60000</longProp>
        <boolProp name="McpServerProcess.keepServerRunningAfterTest">true</boolProp>
      </com.blazemeter.jmeter.mcp.server.McpServerProcess>
