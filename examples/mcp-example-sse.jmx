<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="MCP SSE Example Test Plan">
      <stringProp name="TestPlan.comments">Example plan for the JMeter MCP plugin (SSE transport).

Prerequisites:
  1. Build and install the plugin JAR into JMETER_HOME/lib/ext/
  2. Node.js and npx on PATH
  3. Restart JMeter after installing the plugin

This plan starts @modelcontextprotocol/server-everything in SSE mode via
&quot;MCP Server Process&quot;, then connects with &quot;MCP Client Config (SSE)&quot;.
Do not use MCP Client Config with STDIO to launch an HTTP/SSE server — STDIO
is only for servers that speak MCP over stdin/stdout.

See also: mcp-example.jmx (STDIO), mcp-example-streamable-http.jmx.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
    <hashTree>
      <com.blazemeter.jmeter.mcp.server.McpServerProcess guiclass="com.blazemeter.jmeter.mcp.server.gui.McpServerProcessGui" testclass="com.blazemeter.jmeter.mcp.server.McpServerProcess" testname="MCP Server (SSE)">
        <stringProp name="McpServerProcess.command">npx</stringProp>
        <stringProp name="McpServerProcess.args">-y @modelcontextprotocol/server-everything sse</stringProp>
        <stringProp name="McpServerProcess.env"></stringProp>
        <stringProp name="McpServerProcess.readyHost">localhost</stringProp>
        <longProp name="McpServerProcess.readyPort">3001</longProp>
        <longProp name="McpServerProcess.startupWaitMs">60000</longProp>
      </com.blazemeter.jmeter.mcp.server.McpServerProcess>
      <hashTree/>
      <com.blazemeter.jmeter.mcp.config.McpClientConfig guiclass="com.blazemeter.jmeter.mcp.config.gui.McpClientConfigGui" testclass="com.blazemeter.jmeter.mcp.config.McpClientConfig" testname="MCP Client Config (SSE)" enabled="true">
        <stringProp name="McpClientConfig.name">mcpClient</stringProp>
        <stringProp name="McpClientConfig.transport">SSE</stringProp>
        <stringProp name="McpClientConfig.serverUrl">http://localhost:3001</stringProp>
        <stringProp name="McpClientConfig.endpoint">/sse</stringProp>
        <stringProp name="McpClientConfig.stdioCommand"></stringProp>
        <stringProp name="McpClientConfig.stdioArgs"></stringProp>
        <stringProp name="McpClientConfig.stdioEnv"></stringProp>
        <stringProp name="McpClientConfig.clientName">jmeter-mcp-plugin</stringProp>
        <stringProp name="McpClientConfig.clientVersion">0.1.0</stringProp>
        <longProp name="McpClientConfig.requestTimeoutMs">30000</longProp>
        <longProp name="McpClientConfig.initTimeoutMs">30000</longProp>
        <boolProp name="McpClientConfig.connectOnStartup">false</boolProp>
      </com.blazemeter.jmeter.mcp.config.McpClientConfig>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="MCP Thread Group" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <com.blazemeter.jmeter.mcp.sampler.McpSampler guiclass="com.blazemeter.jmeter.mcp.sampler.gui.McpSamplerGui" testclass="com.blazemeter.jmeter.mcp.sampler.McpSampler" testname="MCP Ping" enabled="true">
          <stringProp name="McpSampler.configName">mcpClient</stringProp>
          <stringProp name="McpSampler.operation">PING</stringProp>
          <stringProp name="McpSampler.toolName"></stringProp>
          <stringProp name="McpSampler.argumentsJson">{}</stringProp>
          <stringProp name="McpSampler.resourceUri"></stringProp>
          <stringProp name="McpSampler.promptName"></stringProp>
        </com.blazemeter.jmeter.mcp.sampler.McpSampler>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert X-MCP-Operation PING" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1596664407">X-MCP-Operation: PING</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Expected X-MCP-Operation: PING response header</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_headers</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert session initialized in headers" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-1649488424">&quot;initialized&quot;:true</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Expected MCP session metadata in response headers (X-MCP-Session)</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_headers</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
        <com.blazemeter.jmeter.mcp.sampler.McpSampler guiclass="com.blazemeter.jmeter.mcp.sampler.gui.McpSamplerGui" testclass="com.blazemeter.jmeter.mcp.sampler.McpSampler" testname="MCP List Tools" enabled="true">
          <stringProp name="McpSampler.configName">mcpClient</stringProp>
          <stringProp name="McpSampler.operation">LIST_TOOLS</stringProp>
          <stringProp name="McpSampler.toolName"></stringProp>
          <stringProp name="McpSampler.argumentsJson">{}</stringProp>
          <stringProp name="McpSampler.resourceUri"></stringProp>
          <stringProp name="McpSampler.promptName"></stringProp>
        </com.blazemeter.jmeter.mcp.sampler.McpSampler>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert X-MCP-Operation LIST_TOOLS" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="1605640191">X-MCP-Operation: LIST_TOOLS</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Expected X-MCP-Operation: LIST_TOOLS response header</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_headers</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Assert tools array in response" enabled="true">
            <stringProp name="JSON_PATH">$.tools</stringProp>
            <stringProp name="EXPECTED_VALUE"></stringProp>
            <boolProp name="JSONVALIDATION">false</boolProp>
            <boolProp name="EXPECT_NULL">false</boolProp>
            <boolProp name="INVERT">false</boolProp>
            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Assert echo tool present" enabled="true">
            <stringProp name="JSON_PATH">$.tools[0].name</stringProp>
            <stringProp name="EXPECTED_VALUE">echo</stringProp>
            <boolProp name="JSONVALIDATION">true</boolProp>
            <boolProp name="EXPECT_NULL">false</boolProp>
            <boolProp name="INVERT">false</boolProp>
            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>
        </hashTree>
        <com.blazemeter.jmeter.mcp.sampler.McpSampler guiclass="com.blazemeter.jmeter.mcp.sampler.gui.McpSamplerGui" testclass="com.blazemeter.jmeter.mcp.sampler.McpSampler" testname="MCP Call Tool (echo)" enabled="true">
          <stringProp name="McpSampler.configName">mcpClient</stringProp>
          <stringProp name="McpSampler.operation">CALL_TOOL</stringProp>
          <stringProp name="McpSampler.toolName">echo</stringProp>
          <stringProp name="McpSampler.argumentsJson">{&quot;message&quot;: &quot;hello from JMeter (SSE)&quot;}</stringProp>
          <stringProp name="McpSampler.resourceUri"></stringProp>
          <stringProp name="McpSampler.promptName"></stringProp>
        </com.blazemeter.jmeter.mcp.sampler.McpSampler>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert X-MCP-Operation CALL_TOOL" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="-2125493996">X-MCP-Operation: CALL_TOOL</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message">Expected X-MCP-Operation: CALL_TOOL response header</stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_headers</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">2</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion" testname="Assert echo tool text" enabled="true">
            <stringProp name="JSON_PATH">$.content[0].text</stringProp>
            <stringProp name="EXPECTED_VALUE">Echo: hello from JMeter (SSE)</stringProp>
            <boolProp name="JSONVALIDATION">true</boolProp>
            <boolProp name="EXPECT_NULL">false</boolProp>
            <boolProp name="INVERT">false</boolProp>
            <boolProp name="ISREGEX">false</boolProp>
          </JSONPathAssertion>
          <hashTree/>
        </hashTree>
        <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
          <objProp>
            <name>saveConfig</name>
            <value class="SampleSaveConfiguration">
              <time>true</time>
              <latency>true</latency>
              <timestamp>true</timestamp>
              <success>true</success>
              <label>true</label>
              <code>true</code>
              <message>true</message>
              <threadName>true</threadName>
              <dataType>true</dataType>
              <encoding>false</encoding>
              <assertions>true</assertions>
              <subresults>true</subresults>
              <responseData>true</responseData>
              <samplerData>true</samplerData>
              <xml>false</xml>
              <fieldNames>true</fieldNames>
              <responseHeaders>true</responseHeaders>
              <requestHeaders>false</requestHeaders>
              <responseDataOnError>false</responseDataOnError>
              <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
              <assertionsResultsToSave>0</assertionsResultsToSave>
              <bytes>true</bytes>
              <sentBytes>true</sentBytes>
              <url>true</url>
              <threadCounts>true</threadCounts>
              <idleTime>true</idleTime>
              <connectTime>true</connectTime>
            </value>
          </objProp>
          <stringProp name="filename"></stringProp>
        </ResultCollector>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
